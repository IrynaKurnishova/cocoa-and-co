---
// One simple illustration per "How it's made" step, picked by `steps.json` → `illustration`.
// All four share a 240×240 canvas and a backdrop circle so they swap cleanly in the pinned view.
import type { StepIllustration } from '../../content/types';

interface Props {
  kind: StepIllustration;
  class?: string;
}

const { kind, class: className } = Astro.props;

const backdrop: Record<StepIllustration, string> = {
  bean: 'var(--color-sun)',
  roast: 'var(--color-pink)',
  conche: 'var(--color-sun)',
  bar: 'var(--color-pink)',
};

const BEAN = '#7A3E22';
const BEAN_DARK = '#4A2416';
const CHOC = '#6B3A26';
const CHOC_LIGHT = '#8C5238';
const PINK_DARK = '#D93A80';

const podBeans = [
  { x: 168, y: 170, rotate: -20, scale: 1 },
  { x: 192, y: 130, rotate: 40, scale: 0.8 },
  { x: 58, y: 184, rotate: 15, scale: 0.9 },
];

const panBeans = [
  { x: 72, y: 120, rotate: -15 },
  { x: 98, y: 116, rotate: 20 },
  { x: 124, y: 120, rotate: -10 },
  { x: 150, y: 116, rotate: 25 },
];

const barSquares = [
  { x: 70, y: 58 },
  { x: 126, y: 58 },
  { x: 70, y: 102 },
  { x: 126, y: 102 },
  { x: 70, y: 150 },
];

const sparkle = 'M0-20Q3-3 20 0Q3 3 0 20Q-3 3-20 0Q-3-3 0-20Z';
---

<svg viewBox="0 0 240 240" width="240" height="240" class={className} aria-hidden="true" focusable="false">
  <circle cx="120" cy="116" r="104" fill={backdrop[kind]}></circle>
  <ellipse cx="120" cy="222" rx="64" ry="7" fill="var(--color-cocoa)" opacity="0.15"></ellipse>

  {
    kind === 'bean' && (
      <>
        <g transform="rotate(-24 108 112)">
          <path d="M108 36v-16" stroke={BEAN_DARK} stroke-width="6" stroke-linecap="round" />
          <ellipse cx="108" cy="112" rx="44" ry="78" fill="var(--color-pink)" />
          <path
            d="M108 40v144M84 46q-12 66 0 132M132 46q12 66 0 132"
            stroke={PINK_DARK}
            stroke-width="4"
            fill="none"
            stroke-linecap="round"
          />
        </g>
        {podBeans.map(({ x, y, rotate, scale }) => (
          <g transform={`translate(${x} ${y}) rotate(${rotate}) scale(${scale})`}>
            <ellipse rx="22" ry="13" fill={BEAN} />
            <path d="M-16 0q16-7 32 0" stroke={BEAN_DARK} stroke-width="3" fill="none" stroke-linecap="round" />
          </g>
        ))}
      </>
    )
  }

  {
    kind === 'roast' && (
      <>
        <path
          d="M80 98q-10-12 0-24t0-24M112 92q-10-12 0-24t0-24M144 98q-10-12 0-24t0-24"
          stroke="var(--color-cream)"
          stroke-width="6"
          fill="none"
          stroke-linecap="round"
        />
        {panBeans.map(({ x, y, rotate }) => (
          <g transform={`translate(${x} ${y}) rotate(${rotate})`}>
            <ellipse rx="15" ry="9" fill={BEAN} />
            <path d="M-11 0q11-5 22 0" stroke={BEAN_DARK} stroke-width="2.5" fill="none" stroke-linecap="round" />
          </g>
        ))}
        <path d="M44 128h136q-4 56-68 56t-68-56Z" fill="var(--color-cocoa)" />
        <rect x="38" y="120" width="148" height="12" rx="6" fill={BEAN_DARK} />
        <rect x="180" y="121" width="44" height="10" rx="5" fill={BEAN_DARK} />
        {[86, 112, 138].map((x, i) => (
          <path transform={`translate(${x} ${i === 1 ? 216 : 212})`} d="M0 0q-11-12 0-26q11 14 0 26Z" fill="var(--color-sun)" />
        ))}
      </>
    )
  }

  {
    kind === 'conche' && (
      <>
        <path d="M36 116h168q-4 84-84 84t-84-84Z" fill="var(--color-pink)" />
        <path d="M150 120v26a6 6 0 0 0 12 0v-26Z" fill={CHOC} />
        <path d="M78 120v14a5 5 0 0 0 10 0v-14Z" fill={CHOC} />
        <ellipse cx="120" cy="116" rx="84" ry="18" fill={CHOC} />
        <path
          d="M70 116a50 10 0 1 1 100 0a36 7 0 1 1-72 0a20 4 0 1 1 40 0"
          stroke={CHOC_LIGHT}
          stroke-width="4"
          fill="none"
          stroke-linecap="round"
        />
        <ellipse cx="120" cy="116" rx="84" ry="18" fill="none" stroke={PINK_DARK} stroke-width="6" />
        <g transform="rotate(28 132 116)">
          <rect x="124" y="30" width="16" height="88" rx="8" fill="var(--color-cream)" />
          <rect x="116" y="20" width="32" height="24" rx="8" fill={BEAN_DARK} />
        </g>
        <path
          d="M30 160q-8-20 0-40M210 160q8-20 0-40"
          stroke="var(--color-cocoa)"
          stroke-width="4"
          fill="none"
          stroke-linecap="round"
        />
      </>
    )
  }

  {
    kind === 'bar' && (
      <>
        <g transform="rotate(-8 120 120)">
          <path d="M72 46h96a12 12 0 0 1 12 12v86h-60v50H72a12 12 0 0 1-12-12V58a12 12 0 0 1 12-12Z" fill={BEAN_DARK} />
          {barSquares.map(({ x, y }) => (
            <g>
              <rect x={x} y={y} width="44" height="34" rx="6" fill={CHOC} />
              <path d={`M${x + 6} ${y + 6}h32`} stroke={CHOC_LIGHT} stroke-width="4" stroke-linecap="round" />
            </g>
          ))}
          <g transform="translate(16 14) rotate(14 150 170)">
            <path d="M120 144h60v38a12 12 0 0 1-12 12h-48Z" fill={BEAN_DARK} />
            <rect x="126" y="150" width="44" height="34" rx="6" fill={CHOC} />
            <path d="M132 156h32" stroke={CHOC_LIGHT} stroke-width="4" stroke-linecap="round" />
          </g>
        </g>
        <rect x="118" y="196" width="8" height="8" rx="2" transform="rotate(20 122 200)" fill={BEAN_DARK} />
        <rect x="104" y="206" width="6" height="6" rx="1.5" transform="rotate(-15 107 209)" fill={BEAN_DARK} />
        <path transform="translate(200 62) scale(0.8)" d={sparkle} fill="var(--color-sun)" />
        <path transform="translate(40 84) scale(0.55)" d={sparkle} fill="var(--color-cream)" />
      </>
    )
  }
</svg>
