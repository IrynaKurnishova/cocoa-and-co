---
// Hero illustration: a half-unwrapped bar with floating beans and sparkles.
// Each floating element is three nested groups so animations never fight:
//   [data-depth]  scroll parallax (amount = depth)
//   [data-float]  idle bobbing
//   transform=""  static position in the drawing
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const beans = [
  { x: 64, y: 118, rotate: 30, scale: 1, depth: 0.9 },
  { x: 424, y: 372, rotate: -24, scale: 1.1, depth: 0.6 },
  { x: 410, y: 84, rotate: 62, scale: 0.7, depth: 1.2 },
  { x: 92, y: 400, rotate: -50, scale: 0.8, depth: 0.4 },
];

const sparkles = [
  { x: 446, y: 214, scale: 1, fill: 'var(--color-pink)', depth: 1 },
  { x: 48, y: 262, scale: 0.8, fill: 'var(--color-sun)', depth: 0.7 },
  { x: 214, y: 30, scale: 0.6, fill: 'var(--color-pink)', depth: 1.4 },
  { x: 360, y: 450, scale: 0.7, fill: 'var(--color-sun)', depth: 0.5 },
];

const squares = [
  { x: 144, y: 86 },
  { x: 246, y: 86 },
  { x: 144, y: 164 },
  { x: 246, y: 164 },
];
---

<svg
  viewBox="0 0 480 480"
  width="480"
  height="480"
  class={className}
  aria-hidden="true"
  focusable="false"
  data-hero-art
>
  <defs>
    <mask id="hero-bite">
      <rect width="480" height="480" fill="#fff"></rect>
      <circle cx="352" cy="74" r="32" fill="#000"></circle>
      <circle cx="320" cy="58" r="20" fill="#000"></circle>
    </mask>
  </defs>

  <g data-depth="0.2">
    <circle cx="248" cy="236" r="188" fill="var(--color-sun)"></circle>
  </g>

  <ellipse cx="240" cy="446" rx="118" ry="12" fill="var(--color-cocoa)" opacity="0.15"></ellipse>

  <g data-hero-bar>
    <g transform="rotate(-10 240 240)">
      <g mask="url(#hero-bite)">
        <rect x="130" y="70" width="220" height="340" rx="16" fill="#4A2416"></rect>
        {
          squares.map(({ x, y }) => (
            <g>
              <rect x={x} y={y} width="90" height="66" rx="8" fill="#6B3A26" />
              <path d={`M${x + 8} ${y + 8}h74`} stroke="#8C5238" stroke-width="5" stroke-linecap="round" />
            </g>
          ))
        }
      </g>

      <path
        d="M126 256V234l14-10 14 10 14-10 14 10 14-10 14 10 14-10 14 10 14-10 14 10 14-10 14 10 14-10 14 10 14-10 14 10 14-10 14 10V256Z"
        fill="#EDE6DA"
      ></path>

      <rect x="122" y="246" width="236" height="178" rx="14" fill="var(--color-pink)"></rect>
      <rect x="122" y="314" width="236" height="26" fill="var(--color-sun)"></rect>
      <circle cx="240" cy="327" r="40" fill="var(--color-cocoa)"></circle>
      <ellipse cx="240" cy="327" rx="20" ry="12" transform="rotate(-30 240 327)" fill="var(--color-cream)"></ellipse>
      <path d="M224 336q16-6 32-18" stroke="var(--color-cocoa)" stroke-width="3" fill="none" stroke-linecap="round"></path>
    </g>
  </g>

  {
    beans.map(({ x, y, rotate, scale, depth }) => (
      <g data-depth={depth}>
        <g data-float>
          <g transform={`translate(${x} ${y}) rotate(${rotate}) scale(${scale})`}>
            <ellipse rx="28" ry="17" fill="#7A3E22" />
            <path d="M-22 0q22-9 44 0" stroke="#4A2416" stroke-width="3" fill="none" stroke-linecap="round" />
          </g>
        </g>
      </g>
    ))
  }

  {
    sparkles.map(({ x, y, scale, fill, depth }) => (
      <g data-depth={depth}>
        <g data-float data-sparkle>
          <path
            transform={`translate(${x} ${y}) scale(${scale})`}
            d="M0-20Q3-3 20 0Q3 3 0 20Q-3 3-20 0Q-3-3 0-20Z"
            fill={fill}
          />
        </g>
      </g>
    ))
  }
</svg>
