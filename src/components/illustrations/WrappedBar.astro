---
// A wrapped bar tinted per flavour: `color` for the wrapper, `accent` for the band and badge.
// Extra attributes (e.g. data-tilt-art) are passed through to the <svg>.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  id: string;
  color: string;
  accent: string;
}

const { id, color, accent, ...rest } = Astro.props;
const clipId = `wrap-clip-${id}`;
---

<svg viewBox="0 0 320 260" width="320" height="260" aria-hidden="true" focusable="false" {...rest}>
  <defs>
    <clipPath id={clipId}>
      <rect x="92" y="44" width="136" height="196" rx="12"></rect>
    </clipPath>
  </defs>

  <g fill={color}>
    <path transform="translate(44 52) scale(0.7)" d="M0-20Q3-3 20 0Q3 3 0 20Q-3 3-20 0Q-3-3 0-20Z"></path>
    <path transform="translate(276 196)" d="M0-20Q3-3 20 0Q3 3 0 20Q-3 3-20 0Q-3-3 0-20Z"></path>
    <path transform="translate(262 40) scale(0.45)" d="M0-20Q3-3 20 0Q3 3 0 20Q-3 3-20 0Q-3-3 0-20Z"></path>
  </g>

  <ellipse cx="160" cy="246" rx="78" ry="8" fill="var(--color-cocoa)" opacity="0.15"></ellipse>

  <g transform="rotate(-6 160 140)">
    <path d="M96 52V34l10-8 10 8 10-8 10 8 10-8 10 8 10-8 10 8 10-8 10 8 10-8 10 8 10-8 10 8V52Z" fill="#EDE6DA"></path>

    <g clip-path={`url(#${clipId})`}>
      <rect x="92" y="44" width="136" height="196" fill={color}></rect>
      <path d="M80 170L240 110V146L80 206Z" fill={accent}></path>
      <rect x="108" y="64" width="54" height="8" rx="4" fill="var(--color-cream)" opacity="0.9"></rect>
      <rect x="108" y="80" width="34" height="6" rx="3" fill="var(--color-cream)" opacity="0.6"></rect>
    </g>

    <circle cx="160" cy="158" r="30" fill="var(--color-cream)"></circle>
    <ellipse cx="160" cy="158" rx="15" ry="9" transform="rotate(-30 160 158)" fill={color}></ellipse>
    <path d="M148 165q12-4 24-14" stroke="var(--color-cream)" stroke-width="2.5" fill="none" stroke-linecap="round"></path>
  </g>
</svg>
