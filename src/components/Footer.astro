---
import { site } from '../content';
import type { SocialNetwork } from '../content/types';
import { getLocale, pick, t } from '../i18n/utils';

const locale = getLocale(Astro.url);
const { footer } = site;

// Simple outline glyphs, drawn on a 24×24 grid with a 2px stroke.
const icons: Record<SocialNetwork, string> = {
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4ZM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM17.5 6.5v.01',
  tiktok: 'M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6',
  youtube: 'M3.5 8.2c.2-1.7 1.4-2.8 3.1-2.9C8.4 5.1 10.2 5 12 5s3.6.1 5.4.3c1.7.1 2.9 1.2 3.1 2.9.2 1.3.3 2.5.3 3.8s-.1 2.5-.3 3.8c-.2 1.7-1.4 2.8-3.1 2.9-1.8.2-3.6.3-5.4.3s-3.6-.1-5.4-.3c-1.7-.1-2.9-1.2-3.1-2.9-.2-1.3-.3-2.5-.3-3.8s.1-2.5.3-3.8ZM10 9v6l5-3Z',
};
---

<footer class="footer bg-cocoa px-4 pt-16 pb-10 text-cream md:px-8 md:pt-24">
  <div class="mx-auto max-w-7xl">
    <p class="max-w-[18ch] font-display text-4xl leading-none md:text-6xl">{pick(footer.tagline, locale)}</p>

    <div class="mt-14 grid gap-12 md:grid-cols-[3fr_2fr] md:gap-16">
      <div id="newsletter">
        <h2 class="text-2xl md:text-3xl">{pick(footer.newsletterTitle, locale)}</h2>
        <p class="mt-2 max-w-prose">{pick(footer.newsletterBody, locale)}</p>

        <form
          class="mt-6"
          novalidate
          data-newsletter
          data-error-empty={t(locale, 'newsletter.errorEmpty')}
          data-error-invalid={t(locale, 'newsletter.errorInvalid')}
        >
          <label for="newsletter-email" class="block font-bold">{t(locale, 'newsletter.label')}</label>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              placeholder={t(locale, 'newsletter.placeholder')}
              aria-describedby="newsletter-error"
              class="min-h-14 w-full min-w-0 rounded-full border-3 border-cream bg-cream px-5 text-lg text-cocoa placeholder:text-cocoa/60 aria-invalid:border-sun sm:flex-1"
            />
            <button
              type="submit"
              class="min-h-14 shrink-0 rounded-full bg-pink px-7 text-lg font-bold text-cocoa shadow-[4px_4px_0_var(--color-cream)] transition-transform duration-200 hover:-translate-y-0.5 motion-reduce:transition-none"
            >
              {t(locale, 'newsletter.submit')}
            </button>
          </div>
          <p id="newsletter-error" class="mt-3 min-h-6 font-bold text-sun" aria-live="polite" data-newsletter-error></p>
        </form>

        <p
          class="mt-6 rounded-3xl bg-sun px-5 py-4 text-lg font-bold text-cocoa"
          tabindex="-1"
          hidden
          data-newsletter-success
        >
          {t(locale, 'newsletter.success')}
        </p>
      </div>

      <div>
        <h2 class="text-2xl md:text-3xl">{pick(footer.socialTitle, locale)}</h2>
        <ul class="mt-6 flex gap-4">
          {
            footer.social.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="noopener"
                  aria-label={t(locale, 'social.label', { name: link.name })}
                  class="grid size-14 place-items-center rounded-full bg-cream text-cocoa shadow-[4px_4px_0_var(--color-pink)] transition-transform duration-200 hover:-translate-y-0.5 hover:-rotate-6 motion-reduce:transition-none"
                >
                  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                    <path
                      d={icons[link.network]}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-1 border-t-2 border-cream/20 pt-6 text-sm md:flex-row md:justify-between">
      <p>{pick(footer.legal, locale)}</p>
      <p>{pick(footer.demoNote, locale)}</p>
    </div>
  </div>
</footer>

<style>
  /* Cream focus ring on the dark footer. */
  .footer :focus-visible {
    outline-color: var(--color-cream);
  }
</style>

<script>
  // Newsletter: client-side validation and a mock success message. No network request.
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const error = form.querySelector<HTMLElement>('[data-newsletter-error]')!;
    const success = form.parentElement!.querySelector<HTMLElement>('[data-newsletter-success]')!;
    let touched = false;

    function validate(): boolean {
      const value = input.value.trim();
      const message = !value ? form.dataset.errorEmpty : EMAIL.test(value) ? '' : form.dataset.errorInvalid;
      error.textContent = message ?? '';
      input.setAttribute('aria-invalid', String(Boolean(message)));
      return !message;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      touched = true;
      if (!validate()) {
        input.focus();
        return;
      }
      // Mock success: swap the form for the message and move focus to it (it gets read out).
      form.hidden = true;
      success.hidden = false;
      success.focus();
    });

    // After the first submit, clear or update the error as the user fixes it.
    input.addEventListener('input', () => touched && validate());
  });
</script>
