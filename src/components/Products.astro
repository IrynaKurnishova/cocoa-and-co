---
import WrappedBar from './illustrations/WrappedBar.astro';
import { products, site } from '../content';
import { getLocale, pick, t } from '../i18n/utils';

const locale = getLocale(Astro.url);
const copy = site.sections.products;
const total = String(products.length).padStart(2, '0');
---

<section
  id="products"
  aria-labelledby="products-title"
  class="@container relative isolate overflow-hidden py-20 text-cream md:py-28"
  data-carousel
  data-status-template={t(locale, 'carousel.status')}
>
  {
    // One full-bleed layer per flavour; the active one fades in (opacity only, no colour tweening).
    products.map((product, i) => (
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-700 data-[active=true]:opacity-100 motion-reduce:transition-none"
        style={{ backgroundColor: product.color }}
        data-carousel-bg
        data-active={String(i === 0)}
      />
    ))
  }

  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <p class="font-bold tracking-widest uppercase">{pick(copy.eyebrow, locale)}</p>
      <h2 id="products-title" class="mt-2 text-4xl md:text-6xl">{pick(copy.title, locale)}</h2>
      <p class="mt-4 max-w-prose text-lg">{pick(copy.intro, locale)}</p>
    </div>

    <div class="flex shrink-0 gap-3">
      {
        (['prev', 'next'] as const).map((dir) => (
          <button
            type="button"
            class="grid size-14 place-items-center rounded-full bg-cream text-cocoa shadow-[4px_4px_0_var(--color-cocoa)] transition-[transform,opacity] duration-200 hover:-translate-y-0.5 focus-visible:outline-cream aria-disabled:cursor-not-allowed aria-disabled:opacity-40 aria-disabled:hover:translate-y-0 motion-reduce:transition-none"
            aria-label={t(locale, dir === 'prev' ? 'carousel.prev' : 'carousel.next')}
            aria-controls="products-track"
            aria-disabled={dir === 'prev' ? 'true' : undefined}
            data-carousel-btn={dir}
          >
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" class:list={[dir === 'prev' && 'rotate-180']}>
              <path
                d="M4 12h16m0 0-6-6m6 6-6 6"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        ))
      }
    </div>
  </div>

  <ul
    id="products-track"
    class="carousel mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto overscroll-x-contain pt-2 pb-6 focus-visible:outline-cream md:mt-14"
    tabindex="0"
    aria-label={t(locale, 'carousel.label')}
    data-carousel-track
  >
    {
      products.map((product, i) => {
        const name = pick(product.name, locale);
        return (
          <li class="shrink-0 snap-start" data-carousel-slide data-name={name}>
            <article
              aria-labelledby={`product-${product.id}`}
              class="flex h-full flex-col rounded-[2rem] bg-cream p-4 text-cocoa shadow-[6px_6px_0_var(--color-cocoa)]"
              data-tilt
            >
              <div class="overflow-hidden rounded-3xl" style={{ backgroundColor: product.accent }}>
                <WrappedBar
                  id={product.id}
                  color={product.color}
                  accent={product.accent}
                  class="h-auto w-full"
                  data-tilt-art
                />
              </div>
              <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
                <p class="text-sm font-bold tracking-widest">
                  {String(i + 1).padStart(2, '0')} / {total}
                </p>
                <h3 id={`product-${product.id}`} class="mt-2 text-3xl md:text-4xl">
                  {name}
                </h3>
                <p class="mt-3">{pick(product.tagline, locale)}</p>
                <ul class="mt-auto flex flex-wrap gap-2 pt-5" aria-label={t(locale, 'products.notes')}>
                  {product.notes.map((note) => (
                    <li class="rounded-full px-3 py-1 text-sm font-bold" style={{ backgroundColor: product.accent }}>
                      {pick(note, locale)}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>

  <p class="sr-only" aria-live="polite" data-carousel-status></p>
</section>

<style>
  /*
   * Lines the first card up with the header's max-w-7xl gutter, and adds trailing space so
   * every card (including the last) can snap to the start. Container units (cqw) are the
   * section width, so padding and card width don't depend on each other.
   */
  .carousel {
    --gutter: 1rem;
    --card-w: min(82cqw, 22rem);
    --pad: max(var(--gutter), calc((100cqw - 80rem) / 2 + var(--gutter)));
    padding-inline: var(--pad) calc(100cqw - var(--pad) - var(--card-w));
    scroll-padding-inline: var(--pad);
    scrollbar-width: none;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .carousel > li {
    width: var(--card-w);
  }

  @media (min-width: 768px) {
    .carousel {
      --gutter: 2rem;
      --card-w: 24rem;
    }
  }
</style>

<script>
  // Carousel behaviour (not animation): buttons, keyboard, active slide, background swap.
  // Tilt and entrance animations live in src/scripts/animations.ts.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const layers = [...root.querySelectorAll<HTMLElement>('[data-carousel-bg]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-btn="prev"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-btn="next"]')!;
    const status = root.querySelector<HTMLElement>('[data-carousel-status]')!;
    const template = root.dataset.statusTemplate ?? '';
    let active = 0;
    let frame = 0;
    let settle = 0;

    const snapStart = () =>
      track.getBoundingClientRect().left + (parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0);

    // The slide whose left edge is nearest the snap line.
    function nearestIndex(): number {
      const line = snapStart();
      let best = 0;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slide.getBoundingClientRect().left - line);
        if (dist < Math.abs(slides[best].getBoundingClientRect().left - line)) best = i;
      });
      return best;
    }

    function setActive(index: number) {
      active = index;
      layers.forEach((layer, i) => (layer.dataset.active = String(i === index)));
      prev.setAttribute('aria-disabled', String(index === 0));
      next.setAttribute('aria-disabled', String(index === slides.length - 1));
    }

    function announce() {
      status.textContent = template
        .replace('{current}', String(active + 1))
        .replace('{total}', String(slides.length))
        .replace('{name}', slides[active].dataset.name ?? '');
    }

    function goTo(index: number) {
      const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
      track.scrollTo({
        left: track.scrollLeft + target.getBoundingClientRect().left - snapStart(),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    }

    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const index = nearestIndex();
          if (index !== active) setActive(index);
        });
        // Announce once scrolling settles, not on every passing slide.
        clearTimeout(settle);
        settle = window.setTimeout(announce, 250);
      },
      { passive: true },
    );

    prev.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));

    track.addEventListener('keydown', (event) => {
      const keys: Record<string, number> = {
        ArrowLeft: active - 1,
        ArrowRight: active + 1,
        Home: 0,
        End: slides.length - 1,
      };
      if (event.key in keys) {
        event.preventDefault();
        goTo(keys[event.key]);
      }
    });

    setActive(nearestIndex());
  });
</script>
