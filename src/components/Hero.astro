---
import { site } from '../content';
import { getLocale, pick } from '../i18n/utils';

const locale = getLocale(Astro.url);
const { hero } = site;
---

<section id="top" aria-labelledby="hero-title" class="px-4 pt-24 pb-16 md:px-8">
  <p class="font-bold uppercase tracking-widest">{pick(hero.eyebrow, locale)}</p>
  <h1 id="hero-title" class="mt-3 text-5xl md:text-8xl">{pick(hero.headline, locale)}</h1>
  <p class="mt-6 max-w-prose text-lg md:text-xl">{pick(hero.subhead, locale)}</p>
  <a href="#flavours" class="mt-8 inline-block rounded-full bg-cocoa px-6 py-3 font-bold text-cream">
    {pick(hero.cta, locale)}
  </a>
</section>
