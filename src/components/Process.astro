---
import ProcessStep from './illustrations/ProcessStep.astro';
import { site, steps } from '../content';
import { getLocale, pick, t } from '../i18n/utils';

const locale = getLocale(Astro.url);
const copy = site.sections.process;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="how-its-made" aria-labelledby="how-its-made-title" class="process px-4 py-20 md:px-8 md:py-28" data-process>
  <div class="mx-auto w-full max-w-7xl">
    <p class="font-bold tracking-widest uppercase">{pick(copy.eyebrow, locale)}</p>
    <h2 id="how-its-made-title" class="mt-2 text-4xl md:text-6xl">{pick(copy.title, locale)}</h2>
    <p class="mt-4 max-w-prose text-lg">{pick(copy.intro, locale)}</p>

    <div class="process-stage relative mt-12 md:mt-16" data-process-stage>
      {
        // Rolling counter + progress bar, only shown in the pinned desktop view. Hidden from screen
        // readers: each step carries its own "Step X of N" label instead.
      }
      <div class="process-counter" aria-hidden="true">
        <div class="flex items-end gap-3 font-display leading-none">
          <span class="process-digits block h-[1em] overflow-hidden text-8xl">
            <span class="block tabular-nums" data-process-digits>
              {steps.map((step) => <span class="block h-[1em]">{pad(step.number)}</span>)}
            </span>
          </span>
          <span class="pb-2 text-2xl">/ {pad(steps.length)}</span>
        </div>
        <div class="mt-4 h-2 w-40 overflow-hidden rounded-full bg-cocoa/15">
          <div class="h-full origin-left rounded-full bg-pink" data-process-progress></div>
        </div>
      </div>

      <ol class="process-steps grid gap-16">
        {
          steps.map((step) => (
            <li class="process-step grid items-center gap-6 md:grid-cols-2 md:gap-12" data-process-step>
              <div class="process-text" data-process-text>
                <p class="process-num inline-grid size-14 place-items-center rounded-full bg-sun font-display text-2xl">
                  <span aria-hidden="true">{pad(step.number)}</span>
                  <span class="sr-only">{t(locale, 'process.step', { current: step.number, total: steps.length })}</span>
                </p>
                <h3 class="process-title mt-4 text-3xl md:text-5xl">{pick(step.title, locale)}</h3>
                <p class="mt-4 max-w-[42ch] text-lg">{pick(step.body, locale)}</p>
              </div>
              <div class="order-first md:order-none" data-process-art>
                <ProcessStep kind={step.illustration} class="process-svg mx-auto h-auto w-full max-w-72 md:max-w-md" />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process-counter {
    display: none;
  }

  /*
   * Pinned view: `data-pinned` is set by animations.ts only on ≥768px × ≥560px with motion
   * allowed, and only if it fits the viewport, so otherwise the steps simply stack.
   */
  .process[data-pinned] {
    display: flex;
    align-items: center;
    height: 100svh;
    padding-block: 3rem;
  }

  .process[data-pinned] .process-counter {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Every step occupies the same cell; GSAP crossfades between them. */
  .process[data-pinned] .process-step {
    grid-area: 1 / 1;
  }

  .process[data-pinned] .process-text {
    align-self: start;
    padding-top: 9rem;
  }

  /* The rolling counter replaces the per-step badge visually; its "Step X of N" label stays. */
  .process[data-pinned] .process-num {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* :global: the svg is rendered by the ProcessStep child component, out of this scope. */
  .process[data-pinned] :global(.process-svg) {
    max-height: 52svh;
  }

  /* Short viewports (small laptops, landscape tablets): tighter pinned layout so it fits. */
  @media (max-height: 820px) {
    .process[data-pinned] {
      padding-block: 1.5rem;
    }

    .process[data-pinned] .process-stage {
      margin-top: 1.5rem;
    }

    .process[data-pinned] .process-digits {
      font-size: var(--text-6xl);
    }

    .process[data-pinned] .process-text {
      padding-top: 6rem;
    }

    .process[data-pinned] .process-title {
      font-size: var(--text-4xl);
    }

    .process[data-pinned] :global(.process-svg) {
      max-height: 45svh;
    }
  }
</style>
